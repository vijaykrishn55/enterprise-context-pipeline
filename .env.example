# Primary LLM Provider: Groq
PRIMARY_PROVIDER=groq
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
PRIMARY_LLM_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_LLM_API_KEY=your_groq_api_key_here

# Fallback Provider
FALLBACK_PROVIDER=mock
FALLBACK_LLM_MODEL=mock-fallback
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=

# Redis Cache
REDIS_ENABLED=true
REDIS_CLUSTER_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# Concurrency and Context Budget
MAX_CONCURRENT_REQUESTS=5
MAX_CONTEXT_TOKENS=32000

# Provider Reliability
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2
RETRY_BASE_SECONDS=1.0

# Conservative Groq Tier Limits
TENANT_RPM_LIMIT=20
TENANT_TPM_LIMIT=6000
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO